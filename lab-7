#include <iostream>
#include <vector>
#include <queue>

using namespace std;

class Solution {
public:
    int minRefuelStops(int target, int startFuel, vector<vector<int>>& stations) {
        int currentFuel = startFuel;
        int stops = 0;
        int prevPosition = 0;
        priority_queue<int> availableFuel;

        for (auto& station : stations) {
            int position = station[0];
            int fuel = station[1];

            currentFuel -= (position - prevPosition);
            prevPosition = position;

            while (currentFuel < 0 && !availableFuel.empty()) {
                currentFuel += availableFuel.top();
                availableFuel.pop();
                stops++;
            }
            if (currentFuel < 0) {
                return -1;
            } 
            availableFuel.push(fuel);
        }

        currentFuel -= (target - prevPosition);
        while (currentFuel < 0 && !availableFuel.empty()) {
            currentFuel += availableFuel.top();
            availableFuel.pop();
            stops++;
        }

        if (currentFuel >= 0) {
            return stops;
        } else {
            return -1;
        }
    }
};
